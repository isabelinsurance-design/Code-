{
  "manifest_version": 3,
  "name": "NetConnect Work Tracker",
  "version": "1.4.0",
  "description": "Records which work sites are in use, when and for how long, calls made in Nextiva, and keyboard/mouse activity level. Names and counts only, never page contents or keystrokes.",
  "permissions": ["tabs", "idle", "storage", "alarms", "notifications", "nativeMessaging"],
  "content_scripts": [
    {
      "matches": ["https://*.nextiva.com/*"],
      "js": ["phone-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://*.nextiva.com/*"],
      "js": ["phone-relay.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["activity.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Work Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
