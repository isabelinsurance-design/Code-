{
  "manifest_version": 3,
  "name": "NetConnect Work Tracker",
  "version": "1.2.0",
  "description": "Records which work sites are in use, when and for how long. Site name and time only, never page contents.",
  "permissions": ["tabs", "idle", "storage", "alarms", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Work Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
